// Strips leading spaces from s$. Not a real MBASIC/BASCOM 2.00 builtin --
// verified against a real IBM BASIC Compiler 2.00 under dosbox-x -- so
// BASCAL ships its own.
library ltrim

function ltrim$(s$)
    i% = 1
    while i% <= LEN(s$) && MID$(s$, i%, 1) = " "
        i% = i% + 1
    end while
    return MID$(s$, i%)
end function
