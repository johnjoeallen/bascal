// Upper-cases s$. Not a real MBASIC/BASCOM 2.00 builtin -- verified against
// a real IBM BASIC Compiler 2.00 under dosbox-x -- so BASCAL ships its own.
library ucase

function ucase$(s$)
    out$ = ""
    for i% = 1 to LEN(s$)
        c% = ASC(MID$(s$, i%, 1))
        if c% >= 97 && c% <= 122 then
            c% = c% - 32
        end if
        out$ = out$ + CHR$(c%)
    end for
    return out$
end function
