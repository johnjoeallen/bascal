// The Delphi Thing -> ThingHolder -> Room/Actor hierarchy supplied common
// fields and a TList.  This game needs neither runtime subtype dispatch nor
// object ownership: record values plus a Thing.location express it directly.
library types
require adventure.model.constants

record Exits
    north: int
    south: int
    west: int
    east: int
end record
record Room
    name: string
    description: string
    exits: Exits             // nested record keeps the map cohesive
end record
record Thing
    name: string
    description: string
    location: int
end record
record Actor
    name: string
    description: string
    room: int
end record

/**
 * Returns the room reached by travelling in one direction.
 * @param direction% one of NORTH, SOUTH, WEST, or EAST.
 * @return the destination room ID, or NO_EXIT when there is no exit.
 */
method exit[Room](direction%): integer
    select case direction%
        case NORTH
            return self.exits.north
        case SOUTH
            return self.exits.south
        case WEST
            return self.exits.west
        case EAST
            return self.exits.east
    end select
    return NO_EXIT
end method
/**
 * Changes one directional exit in place.
 * @param direction% one of NORTH, SOUTH, WEST, or EAST.
 * @param destination% the destination room ID, or NO_EXIT.
 * @effects updates self's own exit table -- the receiver is passed byref,
 *   so this is visible to the caller's own room variable, matching a
 *   record method's own receiver-mutation semantics (see the language
 *   docs' "Methods" chapter) -- BASCAL has no method chaining on a record
 *   receiver (nothing here returns a whole record value), so this is
 *   always called as its own statement, never chained.
 */
method setExit[Room](direction%, destination%)
    select case direction%
        case NORTH
            self.exits.north = destination%
        case SOUTH
            self.exits.south = destination%
        case WEST
            self.exits.west = destination%
        case EAST
            self.exits.east = destination%
    end select
end method

/**
 * Prints the room name and its long description.
 * @effects writes two lines to the console.
 */
method describe[Room]()
    print self.name
    print self.description
end method

/**
 * Moves an actor to a room.
 * @param room% the destination room ID.
 * @effects updates self.room.
 */
method moveTo[Actor](room%)
    self.room = room%
end method
