OPEN A$ FOR APPEND AS #5
on error goto 0
L9390: INPUT "Your name: ";A$
L9400: A$=A$+" "+DATE$
L9410: PRINT #5,A$
L9420: PRINT "Enter your gripe in up to five lines (hit return to quit):"
L9430: Z0 = 1
