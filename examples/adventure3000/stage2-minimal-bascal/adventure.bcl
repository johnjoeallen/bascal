// ADVENTURE/3000 -- Stage 2: minimally-changed BASCAL port.
// See ../README.md for the port's provenance and staging.
//
// Every original numbered line becomes an L<num>: label, and the
// handful of syntax forms BASCAL doesn't accept verbatim -- numeric
// goto/gosub/then/else/restore targets, OPEN ... ELSE, and FSEEK --
// are rewritten as noted inline. Everything else (variable names,
// GOSUB structure, DATA/READ tables) is untouched from the original.
program adventure3000

' The original used PyBASIC's UPPER$/LOWER$, which real BASIC (and BASCAL's
' own basic-target output) doesn't have; BASCAL's stdlib UCASE$/LCASE$ are
' the direct equivalent, so every UPPER$/LOWER$ call below was rewritten to
' use them instead. See ../README.md.
require com.bascal.stdlib.ucase
require com.bascal.stdlib.lcase

L10: ' ADVENTURE/3000 VERSION 3.2     27 FEB 1979 AT 5:30 PM
L11: ' THIS PROGRAM IS RELATIVELY BUG-FREE, BUT ONE STILL MUST
L12: ' realize that murphy 'S LAW STILL PREVAILS!
L13: '
L14: ' ADVENTURE: PROGRAMMED IN HP/3000 BASIC BY BENJAMIN MOSER
L15: ' JAMES MADISON HIGH SCHOOL, VIENNA, VIRGINIA.  THE BASIC LAYOUT OF THE
L16: ' GAME WAS CONCEIVED BY DON WOODS & WILLIE CROWTHER, BOTH OF M.I.T.
L17: '
L18: ' ADVENTURE WAS PORTED TO THE MACINTOSH PLUS BY THE ELIZABETH AND DAVID HUNTER
L19: ' IN MARCH 1998 AND THEN TO PYBASIC FOR THE RASPBERRY RP2040 IN JUNE 2021
L20: ' PRINT "Adventure 3.2 on ";date$;" at ";time$
L21: PRINT "Adventure 3.2 for PyBASIC"
L22: open "AMOVING" for INPUT as #4
L23: ' ADESCRIP, AITEMS, and AMESSAGE are loaded fully into memory
' below instead of opened here -- this port replaces the original's
' fseek-based random access into them, which BASCAL (and classic
' Microsoft BASIC) has no equivalent for. See ../README.md.
L44: ' dirs is an array of possible room directions, it replaces file AMOVING
L45: dim dirs(100,10)
L46: dim indx(303)
L47: dim fraindx(10)
L50: dim s(99)
L51: dim v(100)
L52: dim k(200)
L53: dim o(15)
L70: PRINT:PRINT "Initializing.";
L110: ' initialize
L130: ' total rooms, items,and keywords
L150: l1 = int(RND(1)*4)+1 : l2 = l1
L160: g = 0 : b0 = 1 : sn = 1 : d1 = 1 : d2 = 0 : t = 1 : b1 = 0 : b2 = 0 : p1 = 0: dead = 0
L161: l = 0 : c = 0 : d3 = 0 : b3 = 0 : d0 = 2 : t1 = 100 : t2 = 35 : t3 = 149 : r0 = 0 : c0 = 0: c$=""
L162: KC = 1.02
L170: for ii = 1 to 99
L171:  s(ii) = 0 : v(ii) = 0
end for
L172:
L175: PRINT ".";:v(100) = 0
L182: indx(1) = -1:indx(2)=-1
L190: '   read in possible movement direction array
L192: for z2 = 1 to 100
L193:  INPUT #4,dx1,dx2,dx3,dx4,dx5,dx6,dx7,dx8,dx9,dx0
L194:  dirs(z2,1)=dx1:dirs(z2,2)=dx2:dirs(z2,3)=dx3:dirs(z2,4)=dx4:dirs(z2,5)=dx5
L195:  dirs(z2,6)=dx6:dirs(z2,7)=dx7:dirs(z2,8)=dx8:dirs(z2,9)=dx9:dirs(z2,10)=dx0
L196:  PRINT ".";
end for
L197:
L198: close #4
LA100: ' load ADESCRIP into memory (replaces fseek #1,0 + line-counted read)
dim descrip$(200)
open "ADESCRIP" for INPUT as #1
dcount = 0
LA101: if EOF(1) then goto LA102
dcount = dcount + 1
input #1, descrip$(dcount)
PRINT ".";
goto LA101
LA102: close #1
LA110: ' load AITEMS into memory (replaces fseek #2,0 + full rescan)
dim items$(200)
open "AITEMS" for INPUT as #2
icount = 0
LA111: if EOF(2) then goto LA112
icount = icount + 1
input #2, items$(icount)
PRINT ".";
goto LA111
LA112: close #2
LA120: ' load AMESSAGE into memory (replaces AMESSAGE.IDX + fseek #3,xtmp)
dim msg$(2500)
open "AMESSAGE" for INPUT as #3
mcount = 0
LA121: if EOF(3) then goto LA122
mcount = mcount + 1
input #3, msg$(mcount)
goto LA121
LA122: close #3
gosub L12500
LA130: ' load the short item/object names (originally addressed by a
' computed `restore 9960+x` -- BASCAL restore targets must be a fixed
' label, not an expression, so these become an array instead)
dim itemname$(47)
restore L9961
for ianame = 1 to 47
 read itemname$(ianame)
end for
PRINT
L200: restore L230
L210: '    read in locations of items
L220: for z2 = 1 to T2 step 5
L221: read dx1,dx2,dx3,dx4,dx5:s(z2)=dx1:s(z2+1)=dx2:s(z2+2)=dx3:s(z2+3)=dx4:s(z2+4)=dx5
L222: PRINT ".";
end for
L228:
L230: data 18,25,23,24,21
L231: data 52,0,71,74,58
L232: data 59,69,66,82,100
L233: data 7,49,7,7,7
L234: data 7,12,13,40,38
L235: data 69,0,46,0,0
L236: data 15,60,82,22,250
L240: for ii = 1 to 15 step 5 
L241: read dx1,dx2,dx3,dx4,dx5:o(ii)=dx1:o(ii+1)=dx2:o(ii+2)=dx3:o(ii+3)=dx4:o(ii+4)=dx5
L242: PRINT ".";
end for
L243:
L245: data 1,2,2,2,2
L246: data 3,4,3,3,2
L247: data 5,3,2,3,3
L260: ' ASK IF HE WANTS DIRECTIONS
L263: z59 = 301:gosub L7620
L264: gosub L9860
L266: if z0 then goto L267 else goto L320
L267: z59 = 302:gosub L7620
L280: '    command INPUT routine
L300: ' PRINT room, items
L310: ' If it's dark don't let him see anything
L320: if l1 < 13 or l1 = 58 then goto L350
L321: if l = 1 and (s(18) = l1 or s(18) = -1) then goto L350
L330: z59 = 45:gosub L7620
L340: goto L400
L350: on d0+1 gosub L6780,L7990,L8180
L360: v(l1) = 1
L370: gosub L6680
L375: if dead = 1 then goto L9540
L380: gosub L7800
L390: ' INPUT LOOP --- MULTIPLE COMMAANDS, REMOVE JUNK CHARACTERS
L400: if len(c$) > 0 then goto L500
L410: INPUT ">";c$:c$=ucase$(c$)
L420: if c$ = "" then goto L410
L425: PRINT:PRINT
L430: c$ = ucase$(c$)
L449: '    65-90 = A-Z               48-57 = 0-9         46 = . 44 = ,   
L450: for x = 1 to len(c$)
L460: z5 = asc(mid$(c$,x,1))
L470: if (z5 > 64 and z5 < 91) or (z5 > 47 and z5 < 58) or z5 = 44 then goto L480 else goto L471
L471: c$ = mid$(c$,1,x-1)+" "+mid$(c$,x+1)
end for
L480:
L490: if mid$(c$,len(c$),1) = "," then goto L500
L491: c$ = c$+","
L500: z4 = instr(c$,",")
L510: a$ = ucase$(mid$(c$,1,z4-1)) : c$ = mid$(c$,z4+1)
L550: a$ = " "+a$+" "
L560: ' search a$ for keywords,puut kwd code into k(x)
L570: ' items
L580: data 1,"GOLD",1,"NUGGET",2,"BARS",2,"SILVER",3,"JEWELRY",4,"COINS"
L590: data 5,"DIAMONDS",6,"MING",6,"VASE",7,"PEARL",8,"EGGS",8,"NEST"
L600: data 9,"TRIDENT",10,"EMERALD",11,"PLATINUM",11,"PYRAMID",12,"CHAIN"
L610: data 13,"SPICES",14,"PERSIAN",14,"RUG",15,"TREASURE",15,"CHEST"
L620: data 16,"WATER",17,"OIL",18,"LAMP",18,"LANTERN",19,"KEYS",20,"FOOD",21,"BOTTLE"
L630: data 22,"CAGE",23,"ROD",23,"WAND",24,"CLAM",25,"MAGAZINE",26,"BEAR"
L640: data 27,"AXE",28,"VELVET",28,"PILLOW",29,"SHARDS",30,"OYSTER"
L650: data 31,"BIRD",32,"TROLL",33,"DRAGON",34,"SNAKE",35,"DWARF"
L660: data 36,"ROCK",36,"BOULDER",37,"STAIRS",38,"STEPS",39,"HOUSE",39,"BUILDING"
L665: data 40,"GRATE",41,"STREAM",42,"ROOM",43,"BRIDGE",44,"PIT",45,"VOLCANO"
L667: data 46,"ROAD",47,"ALL",47,"EVERYTHING"
L670: ' DIRECTIONS
L680: data 100,"N",100,"NORTH",101,"NE",101,"NORTHEAST",102,"E",102,"EAST"
L682: data 103,"SE",103,"SOUTHEAST",104,"S",104,"SOUTH",105,"SW",105,"SOUTHWEST"
L684: data 106,"W",106,"WEST",107,"NW",107,"NORTHWEST",108,"U",108,"UP",109,"D",109,"DOWN"
L690: ' VERBS
L700: data 110,"PLUGH",111,"XYZZY",112,"PLOVER",113,"CROSS",114,"CLIMB",115,"JUMP"
L710: data 116,"FILL",117,"EMPTY",117,"POUR",118,"LOOK",118,"L",119,"LIGHT",119,"ON",120,"EXTINGUISH"
L720: data 120,"OFF",121,"IN",121,"ENTER",122,"LEAVE",122,"OUT",123,"INVENTORY",123,"I"
L730: data 124,"GET",124,"CATCH",124,"TAKE",125,"DROP",125,"DUMP",126,"THROW",127,"ATTACK"
L740: data 127,"KILL",128,"FEED",129,"WATER",130,"LOCK",131,"UNLOCK"
L750: data 132,"FREE",132,"RELEASE",133,"WAVE",134,"OPEN",135,"CLOSE"
L760: data 136,"OIL",137,"EAT",138,"DRINK",139,"FEE FIE FOE FOO"
L765: data 140,"SHORT",141,"LONG",142,"BRIEF",143,"QUIT",143,"STOP",143,"END"
L770: data 144,"SCORE",145,"SAVE",146,"LOAD",147,"READ",147,"EXAMINE"
L775: data 148,"YES",148,"Y",149,"BUG",150,"*"
L780: restore L580
L790: for i = 1 to 200
L791: k(i) = 0
end for
L792:
L800: z1 = 0 : z3 = 0
L810: ' T3=TOTAL NUMBER OF KEYWORDS
L820: if z1 > t3 then goto L900
L830: read z1,b$
L840: b$ = " "+b$+" "
L850: ' IF KEYWORD WAS FOUND, NOTE THIS IN K(Z1)
L860: if instr(a$,b$) = 0 then goto L820
L861: k(z1) = 1
L870: ' KEYWORDK #Z1 NOT FOUND
L880: goto L820
L890: ' EXOTIC WORDS
L900: z0 = 36
L910: x = z0
LW910: if x > 46 then goto L960
L920: if k(x) = 0 then goto L960
L930: gosub L8390
L940: print "What do you want to do with the ";d$;"?"
L950: goto L410
x = x + (1)
goto LW910
L960:
L970: x = 110
LW970: if x > t3 then goto L990
L980: if k(x) = 1 then goto L1950
x = x + (1)
goto LW970
L990:
L1000: ' THEN IT'S A DIRECTION
L1010: d = 1
LW1010: if d > 10 then goto L1030
L1020: if k(d+99) = 1 then goto L1070
d = d + (1)
goto LW1010
L1030:
L1040: ' COMMAND NOT A DIRECTION
L1050: goto L1950
L1060: ' CAN HE MOVE THAT WAY?
L1070: z2 = dirs(L1,d)
L1130: if z2 = 255 then goto L1470
L1140: if z2 < 1 or z2 > 254 then goto L1220
L1150: ' NORMAL MOVING
L1160: ' CHECK FOR SPECIAL MOVE CONDITIONS
L1170: goto L1260
L1180: l2 = l1 : l1 = z2
L1190: if s(35) = l2 then goto L1191 else goto L1200
L1191: s(35) = l1
L1200: goto L9780
L1220: z59 = 1
L1221: gosub L7620
L1230: goto L400
L1240: ' SPECIAL ROOM DIRECTIONS
L1250: ' GRATE
L1260: if L1 = 10 and (d = 10 or d = 5) THEN goto L1280
L1261: IF L1 = 11 and (d = 9 or d = 3) then goto L1280 else goto L1320
L1270: ' IF GRATE IS OPEN (G=0) MOVE HIM
L1280: if g = 1 then goto L1180
L1290: z59 = 10:gosub L7620
L1300: goto L400
L1310: ' CAN'T TAKE NUGGET UPPSTAIRS
L1320: if not (l1 = 17 and d = 9 and s(1) = -1) then goto L1360
L1330: z59 = 38:gosub L7620
L1340: goto L400
L1350: ' CRYSTAL BRIDGE AND FISSURE
L1360: if not (l1 = 19 and d = 7 or l1 = 20 and d = 3) then goto L1410
L1370: if b2 then goto L1180
L1380: z59 = 3:gosub L7620
L1390: goto L400
L1400: ' MT. KING & SNAKE
L1410: if not (l1 = 22 and d <> 3 and d <> 9) then goto L1690
L1420: if sn = 0 then goto L1180
L1430: z59 = 50:gosub L7620
L1440: goto L400
L1460: ' bedquilt and random directiosn
L1470: if l1 <> 44 then goto L1590
L1480: if RND(1) > 0.5 then goto L1510
L1490: z59 = 52:gosub L7620
L1500: goto L400
L1510: restore L1530
L1520: ' ROOMS TO JU
L1530: data 33,37,45,92,76
L1540: for z3 = 1 to int(RND(1)*5)+1
L1550:  read z2
end for
L1560:
L1570: goto L1180
L1580: ' WITT's END
L1590: if l1 <> 39 then goto L1220
L1600: ' SHOULD WE LET HIM OUT?
L1610: if RND(1) < 0.15 then goto L1650
L1620: ' NO
L1630: z59 = 52:gosub L7620
L1640: goto L400
L1650: ' YES
L1660: z2 = 38
L1670: goto L1180
L1680: ' Narrow Tunnel
L1690: if not (l1 = 57 or l1 = 58) then goto L1780
L1691: IF K(102)=0 AND K(106)=0 THEN goto L1780
L1700: z3 = 1
LW1700: if z3 > t2 then goto L1750
L1710:  if z3 = 10 then goto L1750
L1720:  if s(z3) <> -1 then goto L1750
L1730:  z59 = 53:gosub L7620
L1740:  goto L400
z3 = z3 + (1)
goto LW1700
L1750:
L1760: goto L1180
L1770: ' TROLL
L1780: IF L1=60 AND D=2 THEN goto L1790
L1781: IF L1=61 AND D=6 THEN goto L1790 ELSE goto L1860
L1790: on t+1 goto L1180,L1800,L1820,L1840
L1800: z59 = 55:gosub L7620
L1810: goto L400
L1820: z59 = 56:gosub L7620
L1821: z59 = 55:gosub L7620
L1830: T=1:goto L400
L1840: t = 2
L1850: goto L1180
L1860: if not (l1 = 73 and d = 1 and d2 = 0) then goto L1890
L1870: z59 = 57:gosub L7620
L1880: goto L400
L1890: if not (l1 = 82 and s(33) = l1 and d = 1) then goto L1180
L1900: ' DRAGON
L1910: z59 = 51:gosub L7620
L1920: goto L400
L1940: ' OTHER COMMANDS
L1950: z1 = 100
LW1950: if z1 > t3 then goto L1970
L1960: if k(z1)=1 then goto L2090
z1 = z1 + (1)
goto LW1950
L1970:
L1980: ' ITEM BO NO VERB?
L1990: ' (was: restore L9961 -- item names now come from itemname$())
L2000: x = 1
LW2000: if x > 35 then goto L2030
L2010:  d$ = itemname$(x)
L2020:  if k(x) = 1 then goto L940
x = x + (1)
goto LW2000
L2030:
L2040: restore L2070
L2050: for x = 1 to int(RND(1)*4)+1
L2051:  read b$
end for
L2052:
L2060: PRINT b$
L2070: data "What?","I don't understand.","I can't understand that.","I don't know that word."
L2080: goto L400
L2090: z1 = z1-109
L2095: on z1 goto L2120,L2220,L2300,L2390,L2570,L2640,L2680,L2860,L2930,L3000,L3080,L3130,L3290,L3450,L3590,L3920,L4160,L4430,L4630,L4800,L4950,L5060,L5190,L5410,L5560,L5750,L5810,L5920,L6000,L6090,L6230,L6270,L6310,L6350,L6410,L8970,L9080,L9220,L4490,L9330
L2110: goto L2040
L2120: ' *** PLUGH ***
L2130: IF L1<>7 THEN goto L2170
L2140: IF S(35)=L1 THEN S(35)=0
L2150: Z2=26
L2160: GOTO L1180
L2170: IF L1<>26 THEN goto L2200
L2180: Z2=7
L2190: GOTO L1180
L2200: z59 = 2:gosub L7620
L2210: GOTO L400
L2220: ' *** XYZZY ***
L2230: IF L1<>7 THEN goto L2270
L2240: IF S(35)=L1 THEN S(35)=0
L2250: Z2=13
L2260: GOTO L1180
L2270: IF L1<>13 THEN goto L2200
L2280: Z2=7
L2290: GOTO L1180
L2300: ' *** PLOVER *** (CAN'T BRING EMERALD WITH HIM)
L2310: IF L1>26 THEN goto L2360
L2320: IF S(35)<>L1 THEN goto L2330
L2325: S(35) = 0
L2330: IF S(10)<>-1 THEN goto L2340
L2335: S(10) = L1
L2340: Z2 = 58
L2350: GOTO L1180
L2360: IF L1<>58 THEN goto L2200
L2370: Z2=26
L2380: GOTO L1180
L2390: ' *** CROSS ***
L2400: IF L1<>19 THEN goto L2470
L2410: IF B2<>0 THEN goto L2440
L2420: z59 = 3:gosub L7620
L2430: GOTO L400
L2440: D=7
L2450: ' JUST GIVE NEW DIRECTION, USE MOVE ROUTINE
L2460: GOTO L1070
L2470: IF L1<>20 THEN goto L2510
L2480: IF B2=0 THEN goto L2420
L2490: D=3
L2500: GOTO L1070
L2510: IF L1<>60 THEN goto L2540
L2520: D=2
L2530: GOTO L1070
L2540: IF L1<>61 THEN goto L2200
L2550: D=6
L2560: GOTO L1070
L2570: ' *** CLIMB ***
L2580: IF L1<>50 THEN goto L2200
L2590: ' CAN HE CLIMB BEANSTALK?
L2600: IF P1<2 THEN goto L2200
L2610: ' YES
L2620: Z2=70
L2630: GOTO L1180
L2640: ' *** JUMP *** STRICTLY SUICIDAL
L2650: IF L1<>16 AND L1<>19 AND L1<>20 AND L1<>27 THEN goto L2200
L2660: z59 = 4:gosub L7620
L2670: GOTO L9550
L2680: ' FILL
L2690: IF S(21)=-1 THEN goto L2730
L2700: B$="bottle"
L2710: PRINT "You don't have the ";b$
L2720: goto L410
L2730: IF B0=0 THEN goto L2760
L2740: z59 = 5:gosub L7620
L2750: GOTO L410
L2760: IF L1<>7 AND L1<>8 AND L1<>9 AND L1<>35 AND L1<>74 AND L1<>81 THEN goto L2790
L2770: B0=1:S(16)=-1
L2780: GOTO L2840
L2790: IF L1=49 THEN goto L2830
L2800: B$="oil"
L2810: PRINT "I see no ";B$;" here."
L2820: GOTO L400
L2830: B0=2:S(17)=-1
L2840: PRINT "The bottle is now filled."
L2850: GOTO L400
L2860: ' *** EMPTY ***
L2870: IF S(21)=-1 THEN goto L2890
L2880: GOTO L2700
L2890: ' EMPTY BOTTLE (ASSUMED FULL)
L2900: S(B0+15)=0:B0=0
L2910: PRINT "Emptied"
L2920: GOTO L400
L2930: ' *** LOOK ***
L2940: if l1 < 13 or l1 = 58 then goto L2970
L2941: if l = 1 and (s(18) = l1 or s(18) = -1) then goto L2970
L2950: z59 = 45:gosub L7620
L2960: goto L400
L2970: gosub L8050
L2980: gosub L6680
L2990: goto L400
L3000: ' *** LIGHT ***
L3010: if s(18) = -1 then goto L3040
L3020: b$ = "lamp"
L3030: goto L2710
L3040: l = 1
L3050: b$ = "on"
L3060: PRINT "The lamp is now ";b$
L3070: goto L2940
L3080: ' *** OFF (EXTINGUSIH) ***
L3090: IF S(18)=-1 THEN goto L3110
L3100: GOTO L3020
L3110: L=0:B$="off"
L3120: GOTO L3060
L3130: ' *** ENTER ***
L3140: IF L1<>6 THEN goto L3180
L3150: ' TO HOUSE
L3160: D=3
L3170: GOTO L1070
L3180: IF L1<>68 THEN goto L3240
L3190: ' TO BARREN ROOM
L3200: D=3
L3210: GOTO L1070
L3240: D = 10
LW3240: if D < 1 then goto L3270
L3250:  Z2 = DIRS(L1,D)
L3260:  IF Z2>0 AND Z2<101 THEN goto L1150
D = D + (-1)
goto LW3240
L3270:
L3280: GOTO L2200
L3290: ' ** LEAVE ***
L3300: IF L1<>7 THEN goto L3340
L3310: ' LEAVE HOUSE
L3320: D=7
L3330: GOTO L1070
L3340: IF L1<>69 THEN goto L3400
L3350: ' LEAVE BARREN ROOM
L3360: D = 7
L3370: GOTO L1070
L3400: D = 1
LW3400: if D > 10 then goto L3430
L3410:  Z2 = DIRS(L1,D)
L3420:  IF Z2>0 AND Z2<101 THEN goto L1150
D = D + (1)
goto LW3400
L3430:
L3440: GOTO L2200
L3450: ' *** INVENTORY ***
L3470: Z0=0
L3480: PRINT "You are carrying:";
L3490: FOR X=1 TO T2
L3510:  IF S(X)<>-1 THEN goto L3540
L3511:  b$ = itemname$(x)
L3520:  PRINT B$
L3530:  Z0 = Z0 + 1
end for
L3540:
L3550: IF Z0=0 THEN goto L3551 else goto L3560
L3551: PRINT "nothing."
L3560: PRINT
L3570: GOTO L400
L3590: ' *** GET ***
L3630: if k(47) = 1 then goto L3680
L3640: gosub L8280
L3650: if z8 > 0 then goto L3680
L3660: PRINT "Get what?"
L3670: goto L2040
L3680: z3 = 1
LW3680: if z3 > t2 then goto L3900
L3710: if k(47) = 1 then goto L3730
L3720: if k(z3) = 0 then goto L3900
L3730: if s(z3) <> l1 then goto L3750
L3740: if s(z3) = l1 then goto L3790
L3750: if k(47) = 1 then goto L3900
L3760: a$ = itemname$(z3):PRINT a$;" not here."
L3770: goto L3900
L3780: ' MUST CHECK NOW FOR LEGALITY OF TAKING ITEM
L3790: z8 = 0
L3800: for x = 1 to t2
L3810: if s(x) <> -1 then goto L3820
L3811: z8 = z8+1
end for
L3820:
L3830: if z8 < 7 then goto L3870
L3840: ' CARRYING TOO MUCH
L3850: z59 = 54:gosub L7620
L3860: goto L410
L3870: goto L6880
