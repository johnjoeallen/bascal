            case 18
                ' *** ATTACK ***
                findMatchedItems()
                if not (z3 = 33 and s(z3) = l1 and l1 = 82) then goto L4520
                ' HE CAN KILL DRAGON
                printMessage(68)
                c$ = ""
                continue
                L4520: if s(32) <> l1 then goto L4560
