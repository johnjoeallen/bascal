                ' skipping the axe-giving check; see checkDwarfAttack()'s own comment)
                goto L4410
                L4360: printMessage(30)
                s(35) = 0
                goto L4410
                L4380: ' NOTHING SPECIAL, JUST DROP ITEM
                if s(35) <> l1 then goto L4400
                checkDwarf() ' (was: GOSUB L8550 -- L8550 was just a comment
