                            goto L9030
                            L9010: print "File ";a$;" not created"
                            c$ = ""
                            continue
                            L9030: print #5, t1;",";t2;",";T3;",";l1;",";l2;",";g;",";B0;",";sn;",";d1;",";d2;",";D0;",";t;",";b1;",";b2;",";p1;",";l;",";c;",";d3;",";B3;",";r0;",";KC
                            for x = 1 to 99
                                print #5, s(x);",";v(x)
                            end for

                            print #5, v(100)
                            close #5
                            print "Game saved"
                            C0 = 0
                            if k(143) = 1 then endGame()
                            c$ = ""
                            continue
