library lineparse
require com.bascal.examples.remline.strings

/* Parse and strip leading decimal line numbers. */

// text$ -- source line to read a leading line number from
function parseLineNumber%(text$)
    text$ = trimLeft$(text$)
    digits$ = ""
    i% = 1
    done% = 0
    while i% <= text$.len() and done% = 0
        ch$ = text$.mid(i%, 1)
        if ch$ >= "0" and ch$ <= "9" then
            digits$ = digits$ + ch$
        else
            done% = 1
        end if
        i% = i% + 1
    end while
    if digits$.len() = 0 then
        return 0
    end if
    return val(digits$)
end function

// text$ -- source line to strip a leading line number from
function stripLineNumber$(text$)
    text$ = trimLeft$(text$)
    i% = 1
    done% = 0
    while i% <= text$.len() and done% = 0
        ch$ = text$.mid(i%, 1)
        if ch$ >= "0" and ch$ <= "9" then
            i% = i% + 1
        else
            done% = 1
        end if
    end while
    if i% > text$.len() then
        return ""
    end if
    if text$.mid(i%, 1) = " " then
        i% = i% + 1
    end if
    return text$.mid(i%)
end function
