(* BASCAL (.bcl) starter grammar for rdgen.
 *
 * This is based on BASCAL grammar rev. 5. The source is intentionally kept
 * in the EBNF-plus-constructor notation used during the design phase while
 * rdgen's grammar frontend is being implemented. Confirmed bcc behavior and
 * deliberate rdgen extensions are documented inline.
 *
 * Deliberate rdgen choice: && and || are ordinary expression operators here.
 * Their contextual validity is a semantic validation pass, not a CFG rule.
 *)

grammar Bascal;

start program;

precedence expr {
    left "xor";
    left "or", "||";
    left "and", "&&";
    left "=", "<>", "<", ">", "<=", ">=";
    left "+", "-";
    left "mod";
    left "\\";
    left "*", "/";
    right "^";
}

(* ----- Lexical terminals ----- *)

lexical identifier       = ( letter | "_" ) , { letter | digit | "_" | "." } , [ suffix ] ;
lexical suffix           = "%" | "$" | "!" | "#" | "&" ;
lexical integer_literal  = digit , { digit } ;
lexical float_literal    = digit , { digit } , "." , digit , { digit } ;
lexical hex_literal      = "&" , ( "H" | "h" ) , { hex_digit } ;
lexical octal_literal    = "&" , ( "O" | "o" ) , { digit } ;
(* Match bcc's current lexer exactly: it has no string escape handling.
 * The proposed backslash/doubled-quote extension belongs in a later grammar
 * revision once the reference lexer adopts it. *)
lexical string_literal   = "\"" , { any_char_except_quote } , "\"" ;
lexical line_comment     = prefix: "'" , body: { any_char_except_newline }
                         => ApostropheComment(prefix: prefix, body: body)
                         | prefix: "//" , body: { any_char_except_newline }
                         => SlashComment(prefix: prefix, body: body) ;
lexical block_comment    = opening: "/*" , body: { any_char } , closing: "*/"
                         => BlockComment(opening: opening, body: body, closing: closing) ;

(* ----- Program and declarations ----- *)

program          = items: { file_item } => File(items: items) ;
file_item        = declaration: program_decl => ProgramDeclaration(declaration: declaration)
                 | declaration: library_decl => LibraryDeclaration(declaration: declaration)
                 | declaration: shared_decl => SharedDeclaration(declaration: declaration)
                 | declaration: require_decl => RequireDeclaration(declaration: declaration)
                 | declaration: import_decl => ImportDeclaration(declaration: declaration)
                 | subprogram: subprogram => Subprogram(subprogram: subprogram)
                 | record: record_decl => Record(record: record)
                 | statement: top_level_statement => Statement(statement: statement) ;

program_decl     = "program" , name: identifier , shared: [ "shared" , identifier ]
                   => ProgramDeclaration(name: name, shared: shared) ;
library_decl     = "library" , name: identifier => LibraryDeclaration(name: name) ;
shared_decl      = "shared" , name: identifier => SharedDeclaration(name: name) ;
require_decl     = "require" , path: identifier => RequireDeclaration(path: path) ;
import_decl      = "import" , path: identifier => ImportDeclaration(path: path) ;

record_decl      = "record" , name: identifier ,
                    combines: [ "combines" , identifier , { "," , identifier } ] ,
                    members: { record_member } until { "end" } ,
                    "end" , "record"
                    => RecordDeclaration(name: name, combines: combines, members: members) ;
record_member    = field: field_decl => Field(field: field)
                 | method: inline_method => InlineMethod(method: method) ;
field_decl       = name: identifier , ":" , field_type: field_type
                   => FieldDeclaration(name: name, field_type: field_type) ;
field_type       = "string" , capacity: [ "(" , integer_literal , ")" ]
                   => StringType(capacity: capacity)
                 | "int16" => Int16Type()
                 | "int" => IntType()
                 | "int32" => Int32Type()
                 | "float32" => Float32Type()
                 | "float64" => Float64Type()
                 | record: identifier => RecordType(record: record) ;

subprogram       = function: function_decl => Function(function: function)
                 | procedure: procedure_decl => Procedure(procedure: procedure)
                 | method: fluent_method_decl => FluentMethod(method: method)
                 | method: method_decl => Method(method: method) ;
function_decl    = "function" , name: typed_ident , "(" , parameters: [ param_list ] , ")"
                   , body: { statement } until { "end" } , "end" , "function"
                   => FunctionDeclaration(name: name, parameters: parameters, body: body) ;
procedure_decl   = "procedure" , name: identifier , "(" , parameters: [ param_list ] , ")"
                   , body: { statement } until { "end" } , "end" , "procedure"
                   => ProcedureDeclaration(name: name, parameters: parameters, body: body) ;
fluent_method_decl = "fluent" , method: method_decl => FluentMethod(method: method) ;
method_decl      = "method" , name: identifier , "[" , receiver: identifier , "]"
                   , "(" , parameters: [ param_list ] , ")" , result: [ ":" , return_type ]
                   , body: { statement } until { "end" } , "end" , "method"
                   => MethodDeclaration(name: name, receiver: receiver, parameters: parameters, result: result, body: body) ;
inline_method    = "method" , name: identifier , "(" , parameters: [ param_list ] , ")"
                   , result: [ ":" , return_type ] , body: { statement } until { "end" }
                   , "end" , "method"
                   => InlineMethodDeclaration(name: name, parameters: parameters, result: result, body: body) ;
return_type      = "integer" | "long" | "single" | "double" | "string"
                 | suffix ;
param_list       = first: param , rest: { "," , param }
                   => ParameterList(first: first, rest: rest) ;
param            = [ "byref" | "byval" ] , name: typed_ident
                   , axes: [ array_axes ] , default: [ "=" , expr ]
                   , type_annotation: [ "as" , identifier ]
                   => Parameter(name: name, axes: axes, default: default, type_annotation: type_annotation) ;
array_axes       = "(" , first: axis , rest: { "," , axis } , ")"
                   => ArrayAxes(first: first, rest: rest) ;
axis             = "?" => InferredCapacity()
                 | capacity: integer_literal => FixedCapacity(capacity: capacity) ;
typed_ident      = identifier ;

(* ----- Statements ----- *)

top_level_statement = statement: statement => Statement(statement: statement)
                    | end: end_stmt => End(end: end) ;
statement        = label: label_stmt => Label(label: label)
                 | core: statement_core , continuation: [ ":" , statement ]
                   => Core(core: core, continuation: continuation) ;
statement_core   = label: label_stmt => Label(label: label)
                 | comment: comment_stmt => Comment(comment: comment)
                 | dim: dim_stmt => Dim(dim: dim)
                 | constant: const_stmt => Const(constant: constant)
                 | print_stmt | lprint_stmt | global: global_decl => Global(global: global)
                 | open: open_stmt => Open(open: open)
                 | line_input: line_input_stmt => LineInput(line_input: line_input)
                 | input: input_stmt => Input(input: input)
                 | write: write_stmt => Write(write: write)
                 | file_declaration: file_decl_stmt => FileDeclaration(file_declaration: file_declaration)
                 | field: field_stmt => Field(field: field)
                 | get: get_stmt => Get(get: get)
                 | put: put_stmt => Put(put: put)
                 | lset: lset_stmt => Lset(lset: lset)
                 | rset: rset_stmt => Rset(rset: rset)
                 | seek: seek_stmt => Seek(seek: seek)
                 | kill: kill_stmt => Kill(kill: kill)
                 | rename: name_stmt => Rename(rename: rename)
                 | close: close_stmt => Close(close: close)
                 | data: data_stmt => Data(data: data)
                 | read: read_stmt => Read(read: read)
                 | restore: restore_stmt => Restore(restore: restore)
                 | locate: locate_stmt => Locate(locate: locate)
                 | color: color_stmt => Color(color: color)
                 | swap: swap_stmt => Swap(swap: swap)
                 | stop: stop_stmt => Stop(stop: stop)
                 | cls: cls_stmt => Cls(cls: cls)
                 | beep: beep_stmt => Beep(beep: beep)
                 | system: system_stmt => System(system: system)
                 | clear: clear_stmt => Clear(clear: clear)
                 | randomize: randomize_stmt => Randomize(randomize: randomize)
                 | poke: poke_stmt => Poke(poke: poke)
                 | out: out_stmt => Out(out: out)
                 | width: width_stmt => Width(width: width)
                 | erase: erase_stmt => Erase(erase: erase)
                 | if_stmt | for_stmt | while_stmt | do_stmt
                 | select_case_stmt
                 | return_statement: return_stmt => Return(return_statement: return_statement)
                 | exit: exit_stmt => Exit(exit: exit)
                 | continue_statement: continue_stmt => Continue(continue_statement: continue_statement)
                 | goto: goto_stmt => Goto(goto: goto)
                 | gosub: gosub_stmt => Gosub(gosub: gosub)
                 | on_error: on_error_goto_stmt => OnErrorGoto(on_error: on_error)
                 | on_branch: on_branch_stmt => OnBranch(on_branch: on_branch)
                 | resume: resume_stmt => Resume(resume: resume)
                 | error: error_stmt => Error(error: error)
                 | throw: throw_stmt => Throw(throw: throw)
                 | option_base: option_base_stmt => OptionBase(option_base: option_base)
                 | try_stmt | end: end_stmt => End(end: end)
                 (* assignment_or_expr_stmt remains the final fallback so
                  * keyword-led statements are not consumed as bare calls. *)
                 | statement: assignment_or_expr_stmt => AssignmentOrExpression(statement: statement) ;
label_stmt       = name: identifier , ":" => Label(name: name) ;
comment_stmt     = raw: line_comment => Raw(comment: raw)
                 | block: block_comment => BlockComment(comment: block) ;
global_decl      = "global" , name: identifier => GlobalDeclaration(name: name) ;
dim_stmt         = ( "dim" | "declare" ) , first: dim_item , rest: { "," , dim_item }
                   => Dim(first: first, rest: rest) ;
dim_item         = name: typed_ident , axes: [ array_axes ] , type_annotation: [ "as" , identifier ]
                   => DimItem(name: name, axes: axes, type_annotation: type_annotation) ;
const_stmt       = "const" , name: identifier , "=" , value: expr => Const(name: name, value: value) ;
print_stmt       = "print" ,
                    ( "#" , expr , "," , [ "using" , expr , ";" ]
                    | "using" , expr , ";"
                    | ε ) ,
                    { print_token } until { "\n" } ;
lprint_stmt      = "lprint" , [ "using" , expr , ";" ] ,
                    { print_token } until { "\n" } ;
print_token      = "," | ";" | expr ;
file_decl_stmt   = "file" , name: identifier , record_type: [ "as" , identifier ] , "=" ,
                    "open" , "(" , path: expr , ")" , mode: [ "for" , file_mode ]
                    => FileDeclaration(name: name, record_type: record_type, path: path, mode: mode) ;
file_mode         = "input" => Input()
                 | "output" => Output()
                 | "append" => Append() ;
field_stmt       = "field" , "#" , channel: expr , "," , first: field_binding ,
                    rest: { "," , field_binding }
                    => Field(channel: channel, first: first, rest: rest) ;
field_binding    = length: expr , "as" , name: identifier
                    => Binding(length: length, name: name) ;
get_stmt         = "get" , "#" , channel: expr , position: [ "," , [ expr ] , [ "," , expr ] ]
                    => Get(channel: channel, position: position) ;
put_stmt         = "put" , "#" , channel: expr , position: [ "," , [ expr ] , [ "," , expr ] ]
                    => Put(channel: channel, position: position) ;
lset_stmt        = "lset" , target: identifier , "=" , value: expr
                   => Lset(target: target, value: value) ;
rset_stmt        = "rset" , target: identifier , "=" , value: expr
                   => Rset(target: target, value: value) ;
open_stmt        = "open" , path: expr , "for" , mode: open_mode ,
                    "as" , "#" , channel: expr , length: [ "len" , "=" , expr ]
                    => Open(path: path, mode: mode, channel: channel, length: length) ;
open_mode         = "input" => Input()
                 | "output" => Output()
                 | "append" => Append()
                 | "random" => Random()
                 | "binary" => Binary() ;
line_input_stmt  = "line" , "input" , "#" , channel: expr , "," , target: expr
                    => LineInput(channel: channel, target: target) ;
input_stmt       = "input" , "#" , channel: expr , "," , first: expr , rest: { "," , expr }
                    => ChannelInput(channel: channel, first: first, rest: rest)
                 | "input" , prompt: [ string_literal , ( ";" | "," ) ] ,
                    first: expr , rest: { "," , expr }
                    => ConsoleInput(prompt: prompt, first: first, rest: rest) ;
write_stmt       = "write" , "#" , channel: expr , values: [ "," , expr , { "," , expr } ]
                    => Write(channel: channel, values: values) ;
seek_stmt        = "seek" , channel: expr , "," , position: expr
                   => Seek(channel: channel, position: position) ;
kill_stmt        = "kill" , path: expr => Kill(path: path) ;
name_stmt        = "name" , source: expr , "as" , destination: expr
                   => Rename(source: source, destination: destination) ;
close_stmt       = "close" , "#" , channel: expr => Close(channel: channel) ;
data_stmt        = "data" , first: expr , rest: { "," , expr } => Data(first: first, rest: rest) ;
read_stmt        = "read" , first: expr , rest: { "," , expr } => Read(first: first, rest: rest) ;
restore_stmt     = "restore" , target: [ same_line identifier ] => Restore(target: target) ;
locate_stmt      = "locate" , row: expr , "," , column: expr
                   => Locate(row: row, column: column) ;
color_stmt       = "color" , foreground: expr , background: [ "," , expr ]
                   => Color(foreground: foreground, background: background) ;
swap_stmt        = "swap" , left: expr , "," , right: expr => Swap(left: left, right: right) ;
stop_stmt        = "stop" => Stop() ;
cls_stmt         = "cls" => Cls() ;
beep_stmt        = "beep" => Beep() ;
system_stmt      = "system" => System() ;
clear_stmt       = "clear" => Clear() ;
randomize_stmt   = "randomize" , seed: [ same_line expr ] => Randomize(seed: seed) ;
poke_stmt        = "poke" , address: expr , "," , value: expr => Poke(address: address, value: value) ;
out_stmt         = "out" , port: expr , "," , value: expr => Out(port: port, value: value) ;
width_stmt       = "width" , channel: [ "#" , expr , "," ] , value: expr
                   => Width(channel: channel, value: value) ;
erase_stmt       = "erase" , first: identifier , rest: { "," , identifier }
                   => Erase(first: first, rest: rest) ;
return_stmt      = "return" , value: [ same_line expr ] => Return(value: value) ;
exit_stmt        = "exit" => Exit() ;
continue_stmt    = "continue" => Continue() ;
goto_stmt        = "goto" , target: identifier => Goto(target: target) ;
gosub_stmt       = "gosub" , target: identifier => Gosub(target: target) ;
on_error_goto_stmt = "on" , "error" , "goto" , target: error_target
                   => OnErrorGoto(target: target) ;
error_target     = label: identifier => Label(label: label)
                 | "0" => Disable() ;
on_branch_stmt   = "on" , selector: expr , branch: branch_kind , first: identifier ,
                    rest: { "," , identifier }
                    => OnBranch(selector: selector, branch: branch, first: first, rest: rest) ;
branch_kind      = "goto" => Goto()
                 | "gosub" => Gosub() ;
resume_stmt      = "resume" , target: [ same_line resume_target ] => Resume(target: target) ;
resume_target    = "next" => Next()
                 | label: identifier => Label(label: label) ;
error_stmt       = "error" , value: expr => Error(value: value) ;
throw_stmt       = "throw" , value: [ same_line expr ] => Throw(value: value) ;
option_base_stmt = "option" , "base" , value: expr => OptionBase(value: value) ;
end_stmt         = "end" => End() ;

if_stmt          = "if" , expr , "then" ,
                    ( newline , block_if_tail | same_line single_line_if_tail ) ;
block_if_tail    = { statement } until { "elseif", "else", "end" } ,
                    ( "elseif" , expr , "then" , block_if_tail
                    | [ "else" , { statement } until { "end" } ] , "end" , "if" ) ;
single_line_if_tail = same_line statement , { same_line statement }
                     , [ "else" , same_line statement , { same_line statement } ] ;
for_stmt         = "for" , typed_ident , "=" , expr ,
                    ( "to" , expr , [ "step" , expr ]
                    | "downto" , expr ) ,
                    { statement } until { "end" } , "end" , [ same_line "for" ] ;
while_stmt       = "while" , expr , { statement } until { "wend", "end" }
                   , ( "wend" | "end" , [ same_line "while" ] ) ;
do_stmt          = "do" , [ same_line do_condition ] , { statement } until { "loop", "end" }
                   , ( "loop" , [ same_line do_condition ] | "end" , [ same_line "do" ] ) ;
do_condition     = ( "while" | "until" ) , expr ;
select_case_stmt = "select" , "case" , expr ,
                    { "case" , case_values ,
                      { statement } until { "case", "end" } }
                    until { "end" } ,
                    [ "case" , "else" ,
                      { statement } until { "end" } ] ,
                    "end" , "select" ;
case_values      = case_value , { "," , case_value } ;
case_value       = "is" , compare_op , expr | expr , [ "to" , expr ] ;
try_stmt         = "try" , { statement } until { "catch", "finally", "end try" } ,
                    [ "catch" , identifier , [ "(" , expr , { "," , expr } , ")" ] ,
                      "," , identifier , [ "," , identifier ] ,
                      { statement } until { "finally", "end try" } ] ,
                    [ "finally" , { statement } until { "end try" } ] , "end" , "try" ;
assignment_or_expr_stmt = let_keyword: [ "let" ] , assignment: mid_assign
                           => MidAssignment(let_keyword: let_keyword, assignment: assignment)
                        | let_keyword: [ "let" ] , target: assign_target , operator: assignment_op , value: expr
                           => Assignment(let_keyword: let_keyword, target: target, operator: operator, value: value)
                        | let_keyword: [ "let" ] , value: expr
                           => Expression(let_keyword: let_keyword, value: value) ;
assign_target       = postfix_expr ;
assignment_op       = "=" => Assign()
                    | "+=" => AddAssign()
                    | "-=" => SubtractAssign()
                    | "*=" => MultiplyAssign()
                    | "/=" => DivideAssign() ;
mid_assign          = "mid" , "$" , "(" , target: expr , "," , start: expr
                      , length: [ "," , expr ] , ")" , "=" , value: expr
                      => MidAssign(target: target, start: start, length: length, value: value) ;

(* ----- Expressions -----
 * Precedence is represented explicitly in the IR rather than inferred by a
 * backend. The order is xor < or/|| < and/&& < comparison < +/- < mod
 * < integer division < multiplication/division < unary - < ^ (right associative).
 *)

expr             = value: xor_expr => Expression(value: value) ;
xor_expr         = first: or_expr , rest: { "xor" , or_expr }
                   => Xor(first: first, rest: rest) ;
or_expr          = first: and_expr , rest: { or_op , and_expr }
                   => Or(first: first, rest: rest) ;
or_op            = "or" => Or()
                 | "||" => ShortCircuitOr() ;
and_expr         = first: not_expr , rest: { and_op , not_expr }
                   => And(first: first, rest: rest) ;
and_op           = "and" => And()
                 | "&&" => ShortCircuitAnd() ;
not_expr         = "not" , operand: not_expr => Not(operand: operand)
                 | value: compare_expr => Compare(value: value) ;
compare_expr     = first: add_expr , rest: { compare_op , add_expr }
                   => Compare(first: first, rest: rest) ;
compare_op       = "<>" | "<=" | ">=" | "=" | "<" | ">" ;
add_expr         = first: mod_expr , rest: { add_op , mod_expr }
                   => Add(first: first, rest: rest) ;
add_op           = "+" => Add()
                 | "-" => Subtract() ;
mod_expr         = first: intdiv_expr , rest: { "mod" , intdiv_expr }
                   => Mod(first: first, rest: rest) ;
intdiv_expr      = first: mul_expr , rest: { "\\" , mul_expr }
                   => IntegerDivide(first: first, rest: rest) ;
mul_expr         = first: unary_expr , rest: { mul_op , unary_expr }
                   => Multiply(first: first, rest: rest) ;
mul_op           = "*" => Multiply()
                 | "/" => Divide() ;
unary_expr       = "-" , operand: unary_expr => Negate(operand: operand)
                 | value: pow_expr => Power(value: value) ;
pow_expr         = base: postfix_expr , exponent: [ "^" , unary_expr ]
                   => Power(base: base, exponent: exponent) ;
postfix_expr     = base: primary , suffixes: { postfix_suffix }
                   => Postfix(base: base, suffixes: suffixes) ;
postfix_suffix   = "." , member: identifier , arguments: [ "(" , [ arg_list ] , ")" ]
                   => Member(member: member, arguments: arguments) ;
arg_list         = first: expr , rest: { "," , expr }
                   => Arguments(first: first, rest: rest) ;
primary          = value: float_literal => Float(value: value)
                 | value: integer_literal => Integer(value: value)
                 | value: hex_literal => Hex(value: value)
                 | value: octal_literal => Octal(value: value)
                 | value: string_literal => String(value: value)
                 | "true" => True()
                 | "false" => False()
                 | value: ident_primary => Identifier(value: value)
                 | value: ( "(" , expr , ")" ) => Parenthesized(value: value)
                 | "{" , fields: record_lit_fields , "}" => Record(fields: fields)
                 | fields: ( "?" , "{" , record_lit_fields , "}" ) => PartialRecord(fields: fields) ;
ident_primary    = name: identifier , "(" , arguments: [ arg_list ] , ")"
                   => CallOrArray(name: name, arguments: arguments)
                 | name: identifier , "[" , index: expr , "]"
                   => FileOrRecordIndex(name: name, index: index)
                 | name: identifier => Name(name: name) ;
record_lit_fields = fields: [ field_init , { "," , field_init } ]
                    => RecordFields(fields: fields) ;
field_init       = name: identifier , ":" , value: expr
                   => Field(name: name, value: value) ;

(* Constructor annotations and recovery declarations are supported by the DSL.
 * This grammar is being converted from provisional AltN variants to named
 * BASCAL AST nodes incrementally, beginning with preserved comment payloads. *)
