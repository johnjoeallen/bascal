(* BASCAL (.bcl) starter grammar for rdgen.
 *
 * This is based on BASCAL grammar rev. 5. The source is intentionally kept
 * in the EBNF-plus-constructor notation used during the design phase while
 * rdgen's grammar frontend is being implemented. Confirmed bcc behavior and
 * deliberate rdgen extensions are documented inline.
 *
 * Deliberate rdgen choice: && and || are ordinary expression operators here.
 * Their contextual validity is a semantic validation pass, not a CFG rule.
 *)

grammar Bascal;

start program;

precedence expr {
    left "xor";
    left "or", "||";
    left "and", "&&";
    left "=", "<>", "<", ">", "<=", ">=";
    left "+", "-";
    left "mod";
    left "\\";
    left "*", "/";
    right "^";
}

(* ----- Lexical terminals ----- *)

lexical identifier       = ( letter | "_" ) , { letter | digit | "_" | "." } , [ suffix ] ;
lexical suffix           = "%" | "$" | "!" | "#" | "&" ;
lexical integer_literal  = digit , { digit } ;
lexical float_literal    = digit , { digit } , "." , digit , { digit } ;
lexical hex_literal      = "&" , ( "H" | "h" ) , { hex_digit } ;
lexical octal_literal    = "&" , ( "O" | "o" ) , { digit } ;
lexical string_literal   = "\"" , { string_char } , "\"" ;
lexical string_char      = escaped_quote | any_char_except_quote ;
lexical escaped_quote    = "\\\"" | "\"\"" ;
lexical line_comment     = ( "'" | "//" ) , { any_char_except_newline } ;
lexical block_comment    = "/*" , { any_char } , "*/" ;

(* ----- Program and declarations ----- *)

program          = { file_item } ;
file_item        = program_decl | library_decl | shared_decl
                 | require_decl | import_decl | subprogram
                 | record_decl | top_level_statement ;

program_decl     = "program" , identifier , [ "shared" , identifier ] ;
library_decl     = "library" , identifier ;
shared_decl      = "shared" , identifier ;
require_decl     = "require" , identifier ;
import_decl      = "import" , identifier ;

record_decl      = "record" , identifier ,
                    [ "combines" , identifier , { "," , identifier } ] ,
                    { field_decl | inline_method } until { "end" } ,
                    "end" , "record" ;
field_decl       = identifier , ":" , field_type ;
field_type       = "string" , [ "(" , integer_literal , ")" ]
                 | "int16" | "int" | "int32" | "float32" | "float64"
                 | identifier ;

subprogram       = function_decl | procedure_decl | fluent_method_decl
                 | method_decl ;
function_decl    = "function" , typed_ident , "(" , [ param_list ] , ")"
                   , { statement } until { "end" } , "end" , "function" ;
procedure_decl   = "procedure" , identifier , "(" , [ param_list ] , ")"
                   , { statement } until { "end" } , "end" , "procedure" ;
fluent_method_decl = "fluent" , method_decl ;
method_decl      = "method" , identifier , "[" , identifier , "]"
                   , "(" , [ param_list ] , ")" , [ ":" , return_type ]
                   , { statement } until { "end" } , "end" , "method" ;
inline_method    = "method" , identifier , "(" , [ param_list ] , ")"
                   , [ ":" , return_type ] , { statement } until { "end" }
                   , "end" , "method" ;
return_type      = "integer" | "long" | "single" | "double" | "string"
                 | suffix ;
param_list       = param , { "," , param } ;
param            = [ "byref" | "byval" ] , typed_ident
                   , [ array_axes ] , [ "=" , expr ]
                   , [ "as" , identifier ] ;
array_axes       = "(" , axis , { "," , axis } , ")" ;
axis             = "?" | integer_literal ;
typed_ident      = identifier ;

(* ----- Statements ----- *)

top_level_statement = statement | end_stmt ;
statement        = label_stmt | comment_stmt | dim_stmt | const_stmt
                 | print_stmt | lprint_stmt | global_decl
                 | open_stmt | line_input_stmt | input_stmt | write_stmt
                 | file_decl_stmt | field_stmt | get_stmt | put_stmt
                 | lset_stmt | rset_stmt
                 | seek_stmt | kill_stmt | name_stmt | close_stmt
                 | data_stmt | read_stmt | restore_stmt
                 | locate_stmt | color_stmt | swap_stmt
                 | stop_stmt | cls_stmt | beep_stmt | system_stmt | clear_stmt
                 | randomize_stmt | poke_stmt | out_stmt | width_stmt
                 | erase_stmt
                 | if_stmt | for_stmt | while_stmt | do_stmt
                 | select_case_stmt
                 | return_stmt | exit_stmt | continue_stmt
                 | goto_stmt | gosub_stmt | try_stmt
                 (* assignment_or_expr_stmt remains the final fallback so
                  * keyword-led statements are not consumed as bare calls. *)
                 | assignment_or_expr_stmt ;
label_stmt       = identifier , ":" ;
comment_stmt     = line_comment | block_comment ;
global_decl      = "global" , identifier ;
dim_stmt         = ( "dim" | "declare" ) , dim_item , { "," , dim_item } ;
dim_item         = typed_ident , [ array_axes ] , [ "as" , identifier ] ;
const_stmt       = "const" , identifier , "=" , expr ;
print_stmt       = "print" , { print_token } until { "\n" } ;
lprint_stmt      = "lprint" , [ "using" , expr , ";" ] , { print_token } until { "\n" } ;
print_token      = "," | ";" | expr ;
file_decl_stmt   = "file" , identifier , [ "as" , identifier ] , "=" ,
                    "open" , "(" , expr , ")" ,
                    [ "for" , ( "input" | "output" | "append" ) ] ;
field_stmt       = "field" , "#" , expr , "," , expr , "as" , identifier ,
                    { "," , expr , "as" , identifier } ;
get_stmt         = "get" , "#" , expr , [ "," , [ expr ] , [ "," , expr ] ] ;
put_stmt         = "put" , "#" , expr , [ "," , [ expr ] , [ "," , expr ] ] ;
lset_stmt        = "lset" , identifier , "=" , expr ;
rset_stmt        = "rset" , identifier , "=" , expr ;
open_stmt        = "open" , expr , "for" ,
                    ( "input" | "output" | "append" | "random" | "binary" ) ,
                    "as" , "#" , expr , [ "len" , "=" , expr ] ;
line_input_stmt  = "line" , "input" , "#" , expr , "," , expr ;
input_stmt       = "input" , "#" , expr , "," , expr , { "," , expr }
                 | "input" , [ string_literal , ( ";" | "," ) ] ,
                    expr , { "," , expr } ;
write_stmt       = "write" , "#" , expr , [ "," , expr , { "," , expr } ] ;
seek_stmt        = "seek" , "#" , expr , "," , expr ;
kill_stmt        = "kill" , expr ;
name_stmt        = "name" , expr , "as" , expr ;
close_stmt       = "close" , "#" , expr ;
data_stmt        = "data" , expr , { "," , expr } ;
read_stmt        = "read" , expr , { "," , expr } ;
restore_stmt     = "restore" , [ identifier ] ;
locate_stmt      = "locate" , expr , "," , expr ;
color_stmt       = "color" , expr , [ "," , expr ] ;
swap_stmt        = "swap" , expr , "," , expr ;
stop_stmt        = "stop" ;
cls_stmt         = "cls" ;
beep_stmt        = "beep" ;
system_stmt      = "system" ;
clear_stmt       = "clear" ;
randomize_stmt   = "randomize" , [ expr ] ;
poke_stmt        = "poke" , expr , "," , expr ;
out_stmt         = "out" , expr , "," , expr ;
width_stmt       = "width" , [ "#" , expr , "," ] , expr ;
erase_stmt       = "erase" , identifier , { "," , identifier } ;
return_stmt      = "return" , [ expr ] ;
exit_stmt        = "exit" ;
continue_stmt    = "continue" ;
goto_stmt        = "goto" , identifier ;
gosub_stmt       = "gosub" , identifier ;
end_stmt         = "end" ;

if_stmt          = "if" , expr , "then" ,
                    ( block_if_tail | single_line_if_tail ) ;
block_if_tail    = { statement } until { "elseif", "else", "end" } ,
                    ( "elseif" , expr , "then" , block_if_tail
                    | [ "else" , { statement } until { "end" } ] , "end" , "if" ) ;
single_line_if_tail = statement , { ":" , statement }
                     , [ "else" , statement , { ":" , statement } ] ;
for_stmt         = "for" , typed_ident , "=" , expr ,
                    ( "to" , expr , [ "step" , expr ]
                    | "downto" , expr ) ,
                    { statement } until { "end" } , "end" , [ "for" ] ;
while_stmt       = "while" , expr , { statement } until { "wend", "end" }
                   , ( "wend" | "end" , [ "while" ] ) ;
do_stmt          = "do" , [ do_condition ] , { statement } until { "loop", "end" }
                   , ( "loop" , [ do_condition ] | "end" , [ "do" ] ) ;
do_condition     = ( "while" | "until" ) , expr ;
select_case_stmt = "select" , "case" , expr ,
                    { "case" , case_values ,
                      { statement } until { "case", "end" } }
                    until { "case", "end" } ,
                    [ "case" , "else" ,
                      { statement } until { "end" } ] ,
                    "end" , "select" ;
case_values      = case_value , { "," , case_value } ;
case_value       = "is" , compare_op , expr | expr , [ "to" , expr ] ;
try_stmt         = "try" , { statement } until { "catch", "finally", "end" } ,
                    [ "catch" , identifier , [ "(" , expr , { "," , expr } , ")" ] ,
                      "," , identifier , [ "," , identifier ] ,
                      { statement } until { "finally", "end" } ] ,
                    [ "finally" , { statement } until { "end" } ] , "end" , "try" ;
assignment_or_expr_stmt = [ "let" ] , expr ;

(* ----- Expressions -----
 * Precedence is represented explicitly in the IR rather than inferred by a
 * backend. The order is xor < or/|| < and/&& < comparison < +/- < mod
 * < integer division < multiplication/division < unary - < ^ (right associative).
 *)

expr             = xor_expr ;
xor_expr         = or_expr , { "xor" , or_expr } ;
or_expr          = and_expr , { ( "or" | "||" ) , and_expr } ;
and_expr         = not_expr , { ( "and" | "&&" ) , not_expr } ;
not_expr         = "not" , not_expr | compare_expr ;
compare_expr     = add_expr , { compare_op , add_expr } ;
compare_op       = "=" | "<>" | "<" | ">" | "<=" | ">=" ;
add_expr         = mod_expr , { ( "+" | "-" ) , mod_expr } ;
mod_expr         = intdiv_expr , { "mod" , intdiv_expr } ;
intdiv_expr      = mul_expr , { "\\" , mul_expr } ;
mul_expr         = unary_expr , { ( "*" | "/" ) , unary_expr } ;
unary_expr       = "-" , unary_expr | pow_expr ;
pow_expr         = postfix_expr , [ "^" , unary_expr ] ;
postfix_expr     = primary , { "." , identifier
                              , [ "(" , [ arg_list ] , ")" ] } ;
arg_list         = expr , { "," , expr } ;
primary          = float_literal | integer_literal | hex_literal | octal_literal
                 | string_literal | "true" | "false"
                 | ident_primary | "(" , expr , ")"
                 | "{" , record_lit_fields , "}"
                 | "?" , "{" , record_lit_fields , "}" ;
ident_primary    = identifier ,
                    ( "(" , [ arg_list ] , ")"
                    | "[" , expr , "]" | ε ) ;
record_lit_fields = [ field_init , { "," , field_init } ] ;
field_init       = identifier , ":" , expr ;

(* Constructor annotations and recovery declarations are the next DSL
 * frontend milestone. Their intended IR forms are represented directly in
 * rdgen-ir::Constructor and rdgen-ir::RecoveryPoint. *)
