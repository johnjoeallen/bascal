// Conformance fixture: CONST lowering, arithmetic, and string/number PRINT
// concatenation -- exercises the CONST-is-not-real-BASCOM fix directly.
program constAndPrint

const MAX_SCORE = 100
const TAX_RATE  = 0.2

score% = 87
bonus% = 5
total% = score% + bonus%

print "Score: "; total%; " / "; MAX_SCORE
print "Tax:   "; TAX_RATE

if total% > MAX_SCORE then
    print "Capped"
else
    print "Under cap"
end if

for i% = 1 to 3
    print "Lap "; i%
end for

end
