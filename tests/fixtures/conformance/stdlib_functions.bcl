program stdlibFunctions
require com.bascal.stdlib.ltrim
require com.bascal.stdlib.rtrim
require com.bascal.stdlib.ucase
require com.bascal.stdlib.lcase
require com.bascal.stdlib.error

print "[" + ltrim$("   hi") + "]"
print "[" + ltrim$("hi") + "]"
print "[" + ltrim$("   ") + "]"
print "[" + ltrim$("") + "]"

print "[" + rtrim$("hi   ") + "]"
print "[" + rtrim$("hi") + "]"
print "[" + rtrim$("   ") + "]"
print "[" + rtrim$("") + "]"

print ucase$("abcXYZ123!")
print lcase$("abcXYZ123!")

' Same functions, called as scalar methods instead (GitHub issue #41) --
' ltrim$/rtrim$/ucase$/lcase$ use scalar method declarations, so the
' ordinary-call form above and the chained method-call form below resolve
' to the identical declaration.
print "[" + "   hi".ltrim() + "]"
print "[" + "hi   ".rtrim() + "]"
print "abcXYZ123!".ucase()
print "abcXYZ123!".lcase()
print "[" + "   padded   ".ltrim().rtrim() + "]"

print error$(53)
print error$(11)
print error$(9999)

end
