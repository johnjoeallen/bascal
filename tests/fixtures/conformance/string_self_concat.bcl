program stringSelfConcat

dim value$

value$ = "abcdefghij"
value$ = value$.left(3) + value$.mid(4, 4) + value$.right(3)
print value$

value$ = value$.left(2) + value$.mid(3, 5) + value$.right(4)
print value$

value$ = "abcdefghij"
value$ = "[" + value$.right(2) + "]" + value$.left(4) + value$.mid(5, 3)
print value$

value$ = "abcdefghij"
value$ = value$.mid(6, 2) + "-" + value$.left(1) + "-" + value$.right(5)
print value$
end
