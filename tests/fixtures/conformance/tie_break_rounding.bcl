// Conformance fixture: round()-tie-break semantics for \, MOD, and AND.
//
// The C backend (src/codegen_c.rs) translates \/MOD/AND/OR/XOR/NOT by
// rounding each operand to an integer via round() (ties away from zero)
// before applying C's native /, %, &, |, ^, or ~. This fixture locks in
// the real BASCOM values at exact .5 ties that round() must match --
// verified once by hand under dosbox-x (2.5 \ 1 = 3, not 2; 2.5 AND 3 = 3,
// not 2), now a permanent regression check instead of a one-off manual
// run. See the c-backend-and-or-bitwise project memory and the per-operator
// comments in codegen_c.rs for the full reasoning.
program tieBreakRounding

print 2.5 \ 1
print 3.5 \ 1
print -2.5 \ 1
print -3.5 \ 1
print 2.5 and 3
print 3.5 and 3
print 2.5 mod 2
print 3.5 mod 2

end
