// JVM-target conformance fixture: IF/ELSE and nested branches.
program branching

score% = 87
if score% >= 90 then
    print "A"
elseif score% >= 80 then
    grade$ = "B"
    print "B"
else
    print "C"
end if
print grade$

if "B" = "B" then print "string match"
if score% < 0 then print "wrong"
if 0.5 then print "non-zero double"
if 0 then print "wrong"

counter% = 1
while counter% <= 3
    print counter%
    counter% = counter% + 1
wend

sum% = 0
for i% = 1 to 3
    sum% = sum% + i%
end for
print sum%

counter% = 1
do until counter% > 3
    if counter% = 3 then exit
    print counter%
    counter% = counter% + 1
end do

choice% = 4
select case choice%
    case 1 to 1, 4
        print "one"
    case 2 to 3
        print "two-or-three"
    case else
        print "other"
end select

day$ = "Saturday"
select case day$
    case "Sunday", "Saturday"
        print "weekend"
    case else
        print "weekday"
end select

end
