program jvmNonIntegerArrays

dim values#(2)
dim words$(2)
dim counts&(2)
dim grid%(1, 2)

procedure fillArrays(byref numbers#(?), byref text$(?), byref whole&(?))
    numbers#(0) = 1.5
    numbers#(1) = numbers#(0) + 2.5
    text$(0) = "hello"
    text$(1) = text$(0) + " world"
    whole&(0) = 4
    whole&(1) = whole&(0) + 5
end procedure

fillArrays(values#, words$, counts&)
grid%(1, 2) = 7
procedure showGrid(byref cells%(?, ?))
    print sizeof(cells%, 0)
    print sizeof(cells%, 1)
    print ubound(cells%, 0)
    print lbound(cells%, 1)
    print ubound(cells%, 1)
    print cells%(1, 2)
end procedure

showGrid(grid%)
print values#(1)
print words$(1)
print counts&(1)
end
