// JVM-target conformance fixture: numeric literals and every arithmetic
// operator currently supported by the native JVM backend.
program numeric

print 2 + 3 * 4
print 3000000000
print 1 + 2.5
print 5 / 2
print 2 ^ 8
print 2.5 \ 1
print -2.5 mod 2
print 10 > 3
print 10 < 3
print 7 = 7
print 7 <> 8
print 7 <= 7
print 7 >= 8
print 6 and 3
print 6 or 3
print 6 xor 3
print not 1
print 2.5 and 3

end
