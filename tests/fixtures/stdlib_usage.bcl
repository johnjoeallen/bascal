program stdlibUsage
require com.bascal.stdlib.ltrim
require com.bascal.stdlib.rtrim
require com.bascal.stdlib.ucase
require com.bascal.stdlib.lcase
require com.bascal.stdlib.error

print ltrim$("  hi")
print rtrim$("hi  ")
print ucase$("hi")
print lcase$("HI")
print error$(ERR_ILLEGAL_FUNCTION_CALL)
print ERR_FILE_NOT_FOUND; " "; ERR_PATH_NOT_FOUND
end
