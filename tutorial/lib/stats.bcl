// stats.bcl — basic statistics library for the BASCAL tutorial.
// Loaded by tutorial/12_require.bcl via:
//   require stats
//
// Provides: mean!, maximum%, minimum%, rangeOf%
library stats

// data% -- array to average; byval, since mean! only reads it
function mean!(data%(?))
    // Arithmetic mean of data%(0..sizeof(data%)-1).
    sum% = 0
    count% = sizeof(data%)
    for i% = 0 to count% - 1
        sum% = sum% + data%(i%)
    end for
    return sum% / count%
end function

// data% -- array to search; byval, since maximum% only reads it
function maximum%(data%(?))
    // Largest element in data%(0..sizeof(data%)-1).
    best% = data%(0)
    for i% = 1 to sizeof(data%) - 1
        if data%(i%) > best% then
            best% = data%(i%)
        end if
    end for
    return best%
end function

// data% -- array to search; byval, since minimum% only reads it
function minimum%(data%(?))
    // Smallest element in data%(0..sizeof(data%)-1).
    best% = data%(0)
    for i% = 1 to sizeof(data%) - 1
        if data%(i%) < best% then
            best% = data%(i%)
        end if
    end for
    return best%
end function

// data% -- array to measure; byval, since rangeOf% only reads it
function rangeOf%(data%(?))
    // Difference between maximum and minimum.
    return maximum%(data%) - minimum%(data%)
end function
