/* Shared string helpers for REMLINE. */
library strings

// UCASE$ isn't a real MBASIC/BASCOM 2.00 builtin (verified against a real
// IBM BASIC Compiler 2.00 under dosbox-x), so upper$() below needs BASCAL's
// own com.bascal.stdlib implementation rather than assuming the target
// dialect provides one.
require com.bascal.stdlib.ucase

// text$ -- string to trim
function trimLeft$(text$)
    /* Walk from the left until the first non-space character appears. */
    i% = 1
    while i% <= len(text$)
        ch$ = mid$(text$, i%, 1)
        if ch$ <> " " then
            return mid$(text$, i%)
        end if
        i% = i% + 1
    end while
    return ""
end function

// text$ -- string to uppercase
function upper$(text$)
    return ucase$(text$)
end function

// text$    -- string to test
// keyword$ -- keyword to look for at the start of text$
function startsWithKeyword%(text$, keyword$)
    t$  = trimLeft$(text$)
    kw$ = keyword$
    t$  = upper$(t$)
    kw$ = upper$(kw$)
    if len(t$) < len(kw$) then
        return 0
    end if
    return left$(t$, len(kw$)) = kw$
end function
